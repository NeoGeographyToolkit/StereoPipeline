def read_overlap_pairs(path, min_cols):
    """
    Read the overlap list. Each non-comment, non-blank line must have at least
    min_cols whitespace-separated tokens. Return a list of token tuples, one per pair.
    """
    if path == "":
        raise Exception("The overlap list was not specified (--overlap-list).")

    pairs = []
    with open(path, 'r') as f:
        for line in f:
            line = line.split('#', 1)[0].strip()
            if line == "":
                continue
            toks = line.split()
            if len(toks) < min_cols:
                raise Exception("An overlap list line needs at least " +
                                str(min_cols) + " entries: " + line)
            pairs.append(tuple(toks[:min_cols]))

    if len(pairs) == 0:
        raise Exception("No pairs were read from the overlap list: " + path)

    return pairs

def read_list(path):
    """Non-empty, non-comment lines from a list file."""
    items = []
    with open(path, 'r') as f:
        for line in f:
            line = line.split('#', 1)[0].strip()
            if line != "":
                items.append(line)
    return items

def mapproj_input_image(image, tool_base_dir):
    """
    For a mapprojected image, return the raw input image it was mapprojected from,
    read from the INPUT_IMAGE_FILE metadata that mapproject writes. Return None if
    that metadata is absent (the image is not mapprojected).
    """
    gdalinfo = asp_rig_utils.find_tool(tool_base_dir, 'gdalinfo')
    try:
        out = subprocess.check_output([gdalinfo, image], universal_newlines=True,
                                      stderr=subprocess.DEVNULL)
    except Exception:
        return None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("INPUT_IMAGE_FILE="):
            return line.split("=", 1)[1].strip()
    return None

def build_image_resolver(image_list, camera_list, seed_dem, tool_base_dir):
    """
    Map an image identity to its (image, camera) from --image-list and --camera-list
    (paired by position). Keys are the image name and its basename. If a seed DEM is
    set (--dem), the images are taken to be mapprojected, so the raw image each was
    mapprojected from (INPUT_IMAGE_FILE metadata) is added as a key too. This lets an
    overlap list or a convergence report name either the mapprojected images or the
    images before mapprojection. The image fed to stereo is always the --image-list
    image, that is, the mapprojected one when a seed DEM is set.
    """
    if image_list == "" or camera_list == "":
        raise Exception("Mode 'dem_mosaic' needs --image-list and --camera-list.")
    images  = read_list(image_list)
    cameras = read_list(camera_list)
    if len(images) != len(cameras):
        raise Exception("The image and camera lists differ in length (" +
                        str(len(images)) + " vs " + str(len(cameras)) + ").")
    resolver = {}
    def add(key, image, camera):
        if key != "":
            resolver.setdefault(key, (image, camera))
    for (img, cam) in zip(images, cameras):
        add(img, img, cam)
        add(os.path.basename(img), img, cam)
        if seed_dem != "":
            raw = mapproj_input_image(img, tool_base_dir)
            if raw is not None:
                add(raw, img, cam)
                add(os.path.basename(raw), img, cam)
    return resolver

def resolve_image(resolver, name):
    """
    The (image, camera) from --image-list for a name given in an overlap list or a
    convergence report, matched by full name or basename, directly or via a
    mapprojected image's recorded raw input (INPUT_IMAGE_FILE).
    """
    if name in resolver:
        return resolver[name]
    base = os.path.basename(name)
    if base in resolver:
        return resolver[base]
    raise Exception("Image not found in --image-list, directly or via a mapprojected "
                    "image's INPUT_IMAGE_FILE metadata: " + name + ". The overlap list "
                    "or convergence report must name images from --image-list, or the "
                    "images they were mapprojected from.")

def gen_pairs(args, all_distorted_images):
    """
    For mode 'mesh': map the image-name pairs to indices in all_distorted_images (the
    images parsed from --camera-poses). The pairs come from --overlap-list, or are
    built from a convergence angle report with --conv-angle-list and
    --conv-angle-range, the same as in mode 'dem_mosaic'.
    """

    dist_indices = asp_rig_utils.create_index_dict(all_distorted_images)
    if args.overlap_list != "":
        name_pairs = read_overlap_pairs(args.overlap_list, 2)
    else:
        name_pairs = conv_angle_pairs(args)

    index_pairs = []
    for (left, right) in name_pairs:
        if left not in dist_indices:
            raise Exception("Image not found among the cameras (--camera-poses): " +
                            left)
        if right not in dist_indices:
            raise Exception("Image not found among the cameras (--camera-poses): " +
                            right)
        index_pairs.append((dist_indices[left], dist_indices[right]))

    return index_pairs

# Assign to each step a number per mode, given the order they should be done in.
STEP_DICTS = {"mesh":       {"stereo": 0, "pc_filter": 1, "mesh_gen": 2},
              "dem_mosaic": {"stereo": 0, "dem": 1, "fuse": 2}}
LAST_STEP  = {"mesh": "mesh_gen", "dem_mosaic": "fuse"}

# The internal step numbers of parallel_stereo (asp_stereo_utils.py). Mode
# 'dem_mosaic' drives parallel_stereo one step range at a time. The tiled stages
# (corr, blend, rfne, tri) are pooled across all pairs; the serial stages (pprc,
# fltr) run per pair. Which of the tiled stages actually spawn per-tile jobs depends
# on the algorithm and subpixel mode. A stage that spawns none for a given run emits
# an empty pool and the finalize step just builds the combined output.
PPRC, CORR, BLEND, RFNE, FLTR, TRI = 0, 1, 2, 3, 4, 5

# One stereo stage per row: (entry point, stop point, pooled, tag, output checked
# after). A pair that fails to produce the checked output is dropped, and the rest
# continue. A None output means there is no reliable top-level file for that stage
# across algorithms, so no pair is dropped after it.
STEREO_STAGES = [
    (PPRC,  CORR,    False, "pprc",  "-L.tif"),
    (CORR,  BLEND,   True,  "corr",  "-D.tif"),
    (BLEND, RFNE,    True,  "blend", None),
    (RFNE,  FLTR,    True,  "rfne",  "-RD.tif"),
    (FLTR,  TRI,     False, "fltr",  "-F.tif"),
    (TRI,   TRI + 1, True,  "tri",   "-PC.tif"),
]

def sanity_checks(args):

    if args.mode not in ("mesh", "dem_mosaic"):
        raise Exception("Must set --mode to 'mesh' or 'dem_mosaic'.")

    if args.out_prefix == "":
        raise Exception("The output prefix was not specified (--output-prefix).")

    # Choosing the pairs, the same way in both modes. Either --overlap-list names the
    # pairs directly, or they are built from a bundle_adjust convergence angle report,
    # with both --conv-angle-list and --conv-angle-range. The two ways are mutually
    # exclusive, and one of them is required.
    have_conv = (args.conv_angle_list != "" or args.conv_angle_range != "")
    if args.overlap_list != "" and have_conv:
        raise Exception("Set either --overlap-list, or --conv-angle-list and "
                        "--conv-angle-range, not both.")
    if have_conv and (args.conv_angle_list == "" or args.conv_angle_range == ""):
        raise Exception("Both --conv-angle-list and --conv-angle-range must be set, "
                        "or neither.")
    if not have_conv and args.overlap_list == "":
        raise Exception("Must set either --overlap-list, or --conv-angle-list and "
                        "--conv-angle-range.")

    if args.mode == "dem_mosaic" and (args.image_list == "" or args.camera_list == ""):
        raise Exception("Mode 'dem_mosaic' needs --image-list and --camera-list.")

    # Resolve the default last step for the mode
    if args.last_step == "":
        args.last_step = LAST_STEP[args.mode]

    step_dict = STEP_DICTS[args.mode]
    for step in [args.first_step, args.last_step]:
        if step not in step_dict:
            raise Exception("Invalid --first-step or --last-step for mode '" +
                            args.mode + "'. See the documentation for allowed values.")

    if args.mode == "mesh":
        if args.camera_poses == "":
            raise Exception("Mode 'mesh' needs the image and camera pose list "
                            "(--camera-poses).")
        if args.rig_config == "":
            raise Exception("Mode 'mesh' needs the rig configuration (--rig-config).")
        if args.rig_sensor == "":
            raise Exception("Mode 'mesh' needs the rig sensor (--rig-sensor).")
        if args.undistorted_crop_win == "":
            raise Exception("Mode 'mesh' needs the undistorted crop window "
                            "(--undistorted-crop-win).")

def write_asp_and_voxblox_cameras(undist_intrinsics_file, distorted_images,
                                  undistorted_images,
                                  world_to_cam):

    if len(undistorted_images) != len(world_to_cam):
        raise Exception("Expecting as many undistorted images as cameras.")
    
    (widx, widy, f, cx, cy) = asp_rig_utils.read_intrinsics(undist_intrinsics_file)
    undist_image_dict = {}
    for image in undistorted_images:
        # Use the image name without dir and extension as a key
        base = os.path.basename(image)
        base = os.path.splitext(base)[0]
        undist_image_dict[base] = image

    # Collect the undistorted images for which camera info is present
    undistorted_images_out = []
    cameras = []
    cam_to_world_files = []
    count = 0
    for dist_image in distorted_images:

        base = os.path.basename(dist_image)
        base = os.path.splitext(base)[0]
        if base not in undist_image_dict:
            raise Exception("Cannot find undistorted image for: "  + dist_image)
        undist_image = undist_image_dict[base]
        tsai_file = os.path.splitext(undist_image)[0] + ".tsai"

        # Find the camera-to-world transform
        cam_to_world = np.linalg.inv(world_to_cam[count])
        asp_rig_utils.write_tsai_camera_file(tsai_file, f, cx, cy, cam_to_world)
        
        # For use with voxblox later
        cam_to_world_file = os.path.splitext(undist_image)[0] + "_cam2world.txt"
        asp_rig_utils.write_cam_to_world_matrix(cam_to_world_file, cam_to_world)

        undistorted_images_out.append(undist_image)
        cameras.append(tsai_file)
        cam_to_world_files.append(cam_to_world_file)
        
        count = count + 1
        
    print("Found " + str(len(undistorted_images)) + " undistorted image(s).")
    print("Wrote: " + str(count) + " camera(s).")

    return (undistorted_images_out, cameras, cam_to_world_files)

def mesh_pc_filter(args, pair, tool_base_dir):
    """
    For mode 'mesh': filter one pair's point cloud with pc_filter, write a debug mesh
    with point2mesh, and a .pcd in the left camera's frame for voxblox. The stereo for
    all pairs already ran via run_pooled_stereo (shared with mode 'dem_mosaic'). A
    failure here is tolerated, as not all pairs are good. Returns the .pcd path.
    """
    (left_image, right_image, left_cam, right_cam) = pair
    pre = os.path.join(pair_dir(args.out_prefix, left_image, right_image), 'run')
    pcd_file = pre + '-PC-filter.pcd'
    pc_filter_options = shlex.split(args.pc_filter_options.replace('\\', ' '))

    # Filter the cloud.
    pcf = asp_rig_utils.find_tool(tool_base_dir, 'pc_filter')
    cmd = [pcf, '--input-cloud', pre + '-PC.tif', '--input-texture', pre + '-L.tif',
           '--output-cloud', pre + '-PC-filter.tif', '--camera', left_cam] + \
           pc_filter_options
    asp_rig_utils.run_cmd(cmd, quit_on_failure = False)

    # A per-pair debug mesh, for inspecting each cloud. A coarse subsample keeps the
    # .obj small.
    p2m = asp_rig_utils.find_tool(tool_base_dir, 'point2mesh')
    cmd = [p2m, "-s", "4", "--texture-step-size", "1",
           pre + '-PC-filter.tif', pre + '-L.tif']
    asp_rig_utils.run_cmd(cmd, quit_on_failure = False)

    # The .pcd in the left camera's frame, for voxblox fusion.
    cmd = [pcf, '--input-cloud', pre + '-PC.tif', '--input-texture', pre + '-L.tif',
           '--output-cloud', pcd_file, '--camera', left_cam,
           '--transform-to-camera-coordinates',
           '--output-weight', pre + '-PC-weight.tif'] + pc_filter_options
    asp_rig_utils.run_cmd(cmd, quit_on_failure = False)

    return pcd_file

def fuse_clouds(args, index_pairs, cam_to_world_files, pcd_files, tool_base_dir):
    """
    Fuse the per-pair clouds into one mesh with voxblox (mode 'mesh'). Pairs whose
    .pcd was not produced (a failed stereo pair) are skipped.
    """
    voxblox_index = args.out_prefix + "-voxblox_index.txt"
    fused_mesh    = args.out_prefix + "-fused_mesh.ply"
    print("Writing: " + voxblox_index)
    with open(voxblox_index, "w") as handle:
        for t in range(len(index_pairs)):
            if not os.path.exists(pcd_files[t]):
                continue
            L = index_pairs[t][0]
            handle.write(cam_to_world_files[L] + "\n")
            handle.write(pcd_files[t] + "\n")

    mesh_gen_options = shlex.split(args.mesh_gen_options.replace('\\', ' '))
    vox = asp_rig_utils.find_tool(tool_base_dir, 'voxblox_mesh')
    cmd = [vox, '--index', voxblox_index, '--output_mesh', fused_mesh] + \
          mesh_gen_options
    asp_rig_utils.run_cmd(cmd, quit_on_failure = True)
    print("Wrote: " + fused_mesh)

# Functions for mode 'dem_mosaic' below.

def pair_dir(out_prefix, left_image, right_image):
    """The output directory for one stereo pair, from the output prefix and the image
    base names. All per-pair stereo data goes under <out_prefix>-pairs."""
    lp = os.path.splitext(os.path.basename(left_image))[0]
    rp = os.path.splitext(os.path.basename(right_image))[0]
    return os.path.join(out_prefix + "-pairs", lp + "__" + rp)

def run_parallel(cmds, num_parallel):
    """
    Run a list of shell-command strings, up to num_parallel at a time, with GNU
    parallel. A pair that fails does not stop the others (--halt never), as not all
    stereo pairs are necessarily good.
    """
    if len(cmds) == 0:
        return

    par = asp_rig_utils.which('parallel')
    if par is None:
        raise Exception("Cannot find GNU 'parallel' on the PATH.")

    with tempfile.NamedTemporaryFile('w', suffix='.jobs', delete=False) as jf:
        jf.write("\n".join(cmds) + "\n")
        jobs = jf.name

    cmd = [par, '--will-cite', '-j', str(num_parallel), '--halt', 'never']

    # Decide whether to spread the jobs over the PBS nodes with ssh. The node file lists
    # the unique hosts. ssh-ing to a SINGLE node (any select=1 job, the common case) hits
    # that node's sshd MaxStartups/MaxSessions cap (often 16): GNU parallel opens one ssh
    # per job, connections past the cap are refused, and with --halt never those jobs are
    # silently dropped, leaving holes in the DEM mosaic. On a single host there is nothing
    # to distribute, so run locally, with no ssh and no login cap. Spread over ssh only
    # when there really are several hosts, and then pace the logins (--sshdelay) and retry
    # a refused launch (--retries) to survive that same cap.
    nodefile = os.environ.get("PBS_NODEFILE")
    hosts = []
    if nodefile is not None and os.path.exists(nodefile):
        with open(nodefile, 'r') as f:
            hosts = sorted(set(h.strip() for h in f if h.strip()))
    if len(hosts) > 1:
        # GNU parallel ssh jobs start in the remote home directory, so force the
        # shared work directory and propagate the environment that finds the ASP
        # tools. This needs a shared file system across the nodes.
        cmd += ['--sshloginfile', nodefile, '--workdir', os.getcwd(),
                '--sshdelay', '0.2', '--retries', '3',
                '--env', 'PATH', '--env', 'LD_LIBRARY_PATH',
                '--env', 'ISISROOT', '--env', 'ISISDATA']
    cmd += ['-a', jobs]
    print("Running " + str(len(cmds)) + " job(s), " + str(num_parallel) + " at a time.")

    # GNU parallel (and the ssh it spawns) fails to start with ASP's bundled libs
    # on LD_LIBRARY_PATH (e.g. OpenSSL version mismatch), so temporarily hide them.
    # The propagated LD_LIBRARY_PATH is then empty; each remote ASP tool sets its
    # own via its wrapper. Same bugfix as parallel_stereo (asp_system_utils.py).
    saved_ld = os.environ.get('LD_LIBRARY_PATH')
    if saved_ld is not None:
        os.environ['ASP_LIBRARY_PATH'] = saved_ld
        os.environ['LD_LIBRARY_PATH'] = ''

    ret = subprocess.call(cmd)

    if saved_ld is not None:
        os.environ['LD_LIBRARY_PATH'] = saved_ld

    os.unlink(jobs)
    if ret != 0:
        print("Warning: GNU parallel returned " + str(ret) +
              ". Some pairs may have failed.")

def stereo_thread_options(args):
    """
    The parallelism options handed to each parallel_stereo pair. This tool owns the
    fan-out across pairs, so each pair runs with --processes 1.
    """
    opts = ['--processes', '1']
    if args.threads > 0:
        opts += ['--threads-multiprocess', str(args.threads),
                 '--threads-singleprocess', str(args.threads)]
    return opts

def stereo_pair_cmd(ps, args, pair, entry, stop, stereo_options, seed, extra):
    """
    One parallel_stereo command line for a pair, over a step range. The seed DEM, if
    any, is the trailing positional argument (for mapprojected images).
    """
    (li, ri, lc, rc) = pair
    pre = os.path.join(pair_dir(args.out_prefix, li, ri), 'run')
    cmd = [ps] + stereo_thread_options(args) + stereo_options      + \
          ['--entry-point', str(entry), '--stop-point', str(stop)] + \
          extra + [li, ri, lc, rc, pre] + seed
    return shlex.join(cmd)

def keep_pairs(pairs, args, suffix):
    """
    Keep only the pairs that produced run<suffix>. A pair that fails a stage (for
    example over textureless water) is dropped, and the rest continue.
    """
    if suffix is None:
        return pairs
    out = []
    for pair in pairs:
        pre = os.path.join(pair_dir(args.out_prefix, pair[0], pair[1]), 'run')
        if os.path.exists(pre + suffix):
            out.append(pair)
    if len(out) < len(pairs):
        print("  Dropped " + str(len(pairs) - len(out)) +
              " pair(s) missing " + suffix + ".")
    return out

def stereo_serial_stage(ps, args, pairs, entry, stop, tag, stereo_options, seed):
    """A non-tiled stereo stage (pprc, fltr): run each pair, --processes at a time."""
    cmds = [stereo_pair_cmd(ps, args, pair, entry, stop, stereo_options, seed, [])
            for pair in pairs]
    print("Stage '" + tag + "': " + str(len(cmds)) + " pair job(s).")
    run_parallel(cmds, args.processes)

def stereo_pool_stage(ps, args, pairs, entry, stop, tag, stereo_options, seed):
    """
    A tiled stereo stage (corr, rfne, tri). Ask parallel_stereo to emit the per-tile
    commands of every pair (--emit-tile-commands), pool them into one global job, run
    that pool (spread over the nodes if any), then finalize each pair with --skip-spawn
    (its serial setup and wrap-up, without re-spawning the tiles). Pooling the tiles of
    all pairs balances the load better than draining one pair at a time.
    """
    emit_cmds = []
    manifests = []
    for pair in pairs:
        pre = os.path.join(pair_dir(args.out_prefix, pair[0], pair[1]), 'run')
        mf = pre + '-' + tag + '-tiles.txt'
        manifests.append(mf)
        emit_cmds.append(stereo_pair_cmd(ps, args, pair, entry, stop, stereo_options,
                                         seed, ['--emit-tile-commands', mf]))
    run_parallel(emit_cmds, args.processes)

    pool = []
    for mf in manifests:
        if os.path.exists(mf):
            with open(mf, 'r') as f:
                pool += [ln.rstrip('\n') for ln in f if ln.strip() != ""]
    print("Stage '" + tag + "': global tile pool of " + str(len(pool)) +
          " tile(s) from " + str(len(pairs)) + " pair(s).")
    run_parallel(pool, args.processes)

    finalize = [stereo_pair_cmd(ps, args, pair, entry, stop, stereo_options, seed,
                                ['--skip-spawn']) for pair in pairs]
    run_parallel(finalize, args.processes)

def run_pooled_stereo(args, pairs, tool_base_dir):
    """
    Run stereo for all pairs, shared by both modes. This tool drives parallel_stereo
    through its own per-tile machinery, one step range at a time. It does not
    reimplement stereo. The tiled stages are pooled across all pairs (see
    stereo_pool_stage), so the load is balanced across all pairs and spread over the
    PBS nodes if any; the serial stages run per pair. A pair that fails a stage is
    dropped after that stage. Each pair is (left_image, right_image, left_camera,
    right_camera); the seed DEM (--dem), if set, is appended per pair.
    """
    print("Step 'stereo': distributed parallel_stereo over " + str(len(pairs)) +
          " pair(s).")
    ps = asp_rig_utils.find_tool(tool_base_dir, 'parallel_stereo')
    stereo_options = shlex.split(args.stereo_options.replace('\\', ' '))
    # For mapprojected images the seed DEM is the trailing positional argument.
    seed = [args.seed_dem] if args.seed_dem != "" else []
    for pair in pairs:
        asp_rig_utils.mkdir_p(pair_dir(args.out_prefix, pair[0], pair[1]))

    for (entry, stop, pooled, tag, suffix) in STEREO_STAGES:
        if len(pairs) == 0:
            print("No pairs left to run stereo on.")
            return pairs
        if pooled:
            stereo_pool_stage(ps, args, pairs, entry, stop, tag, stereo_options, seed)
        else:
            stereo_serial_stage(ps, args, pairs, entry, stop, tag, stereo_options, seed)
        pairs = keep_pairs(pairs, args, suffix)

    # The pairs that survived every stage (produced run-PC.tif). Only these go on to
    # the DEM and fuse steps.
    return pairs

def gdal_pixel_size(path):
    """The pixel size in map units of a raster, or None."""
    info = subprocess.run([asp_rig_utils.which('gdalinfo'), path],
                          capture_output=True, text=True).stdout
    m = re.search(r'Pixel Size = \(\s*(-?[0-9.eE+]+),\s*(-?[0-9.eE+]+)\)', info)
    if m is None:
        return None
    return abs(float(m.group(1)))

def gdal_proj4(path):
    """The proj4 projection string of a raster, or the empty string."""
    tool = asp_rig_utils.which('gdalsrsinfo')
    if tool is None:
        return ""
    return subprocess.run([tool, '-o', 'proj4', path],
                          capture_output=True, text=True).stdout.strip()

def dem_stage_dem(args, pairs, tool_base_dir):
    """
    Run point2dem for each pair (mode 'dem_mosaic'). All per-pair DEMs must land on one
    shared grid so the mosaic is clean. If both --tr and --t_srs are set in
    --point2dem-options, they are used for every pair. Otherwise the first pair sets the
    grid (its resolution and projection), and the rest reuse it. A projection can also
    come from the seed DEM --dem.
    """
    print("Step 'dem': point2dem for each pair.")
    p2d = asp_rig_utils.find_tool(tool_base_dir, 'point2dem')
    opts = shlex.split(args.point2dem_options.replace('\\', ' '))
    have_tr = '--tr' in opts
    have_srs = '--t_srs' in opts
    # As in stereo_dist (:numref:`stereo_dist`), --orthoimage may be passed with no
    # argument. point2dem needs the texture (the pair's L.tif) after the point cloud,
    # so it is added per pair below. Strip the bare flag from the shared options.
    want_ortho = '--orthoimage' in opts
    opts = [o for o in opts if o != '--orthoimage']

    # The projection can also come from the seed DEM.
    proj = ""
    if not have_srs and args.seed_dem != "":
        proj = gdal_proj4(args.seed_dem)

    def p2d_cmd(pair, extra):
        (li, ri, lc, rc) = pair
        pre = os.path.join(pair_dir(args.out_prefix, li, ri), 'run')
        cmd = [p2d] + opts + extra + ['-o', pre, pre + '-PC.tif']
        if want_ortho:
            cmd += ['--orthoimage', pre + '-L.tif']
        return shlex.join(cmd)

    srs_extra = [] if have_srs or proj == "" else ['--t_srs', proj]

    if have_tr and (have_srs or proj != ""):
        # The grid is fully pinned: same --tr and --t_srs for every pair.
        run_parallel([p2d_cmd(p, srs_extra) for p in pairs], args.processes)
        return

    # The first pair sets the grid, the rest reuse it.
    print("Running point2dem on the first pair to set the shared grid.")
    run_parallel([p2d_cmd(pairs[0], srs_extra)], 1)
    first_pre = os.path.join(pair_dir(args.out_prefix, pairs[0][0], pairs[0][1]), 'run')
    first_dem = first_pre + '-DEM.tif'
    tr = None if have_tr else gdal_pixel_size(first_dem)
    if not have_srs and proj == "":
        proj = gdal_proj4(first_dem)

    extra = []
    if tr is not None:
        extra += ['--tr', repr(tr)]
    if not have_srs and proj != "":
        extra += ['--t_srs', proj]
    print("Shared grid from the first DEM:" +
          ((" --tr " + repr(tr)) if tr is not None else "") +
          ((" --t_srs " + proj) if proj != "" else ""))
    run_parallel([p2d_cmd(p, extra) for p in pairs[1:]], args.processes)

def gdal_mean(path):
    """The mean value of a raster (from gdalinfo -stats), or None."""
    info = subprocess.run([asp_rig_utils.which('gdalinfo'), '-stats', path],
                          capture_output=True, text=True).stdout
    m = re.search(r'STATISTICS_MEAN=(-?[0-9.eE+]+)', info)
    return float(m.group(1)) if m else None

def gdal_bbox(path):
    """The (ulx, uly, lrx, lry) map bounding box of a raster, or None."""
    info = subprocess.run([asp_rig_utils.which('gdalinfo'), path],
                          capture_output=True, text=True).stdout
    ul = re.search(r'Upper Left\s+\(\s*(-?[0-9.]+),\s*(-?[0-9.]+)\)', info)
    lr = re.search(r'Lower Right\s+\(\s*(-?[0-9.]+),\s*(-?[0-9.]+)\)', info)
    return (ul.group(1), ul.group(2), lr.group(1), lr.group(2)) if ul and lr else None

def blunder_filter(pres, ref_dem, tol):
    """
    Given the per-pair output prefixes, drop a pair (and all its products) if the mean
    elevation of its DEM departs from the reference DEM over the same footprint by more
    than tol. This is relief aware: it compares each DEM to the reference locally, not
    to a global value, so real high and low terrain is kept and only true blunders are
    dropped. Where the reference has no data over a DEM, the pair is kept.
    """
    gt = asp_rig_utils.which('gdal_translate')
    keep = []
    dropped = 0
    for pre in pres:
        d = pre + '-DEM.tif'
        dm = gdal_mean(d)
        if dm is None:
            continue
        bb = gdal_bbox(d)
        rm = None
        if bb is not None:
            with tempfile.NamedTemporaryFile(suffix='.tif', delete=False) as tf:
                crop = tf.name
            subprocess.run([gt, '-q', '-projwin', bb[0], bb[1], bb[2], bb[3],
                            ref_dem, crop], capture_output=True, text=True)
            if os.path.exists(crop):
                rm = gdal_mean(crop)
                os.unlink(crop)
        if rm is None or abs(dm - rm) <= tol:
            keep.append(pre)
        else:
            dropped += 1

    print("Blunder filter (tolerance " + str(tol) + " m): kept " + str(len(keep)) +
          ", dropped " + str(dropped) + ".")
    return keep

def dem_stage_fuse(args, pairs, tool_base_dir):
    """
    Mosaic the per-pair products (mode 'dem_mosaic'). The DEM is always produced. The
    maximum triangulation error is mosaicked if --errorimage was in --point2dem-options,
    and an orthoimage (DRG) if --orthoimage was, matching stereo_dist
    (:numref:`stereo_dist`). The output names follow point2dem: dem_mosaic-DEM.tif,
    dem_mosaic-IntersectionErr.tif, dem_mosaic-DRG.tif.
    """
    print("Step 'fuse': dem_mosaic of the per-pair products.")
    dm = asp_rig_utils.find_tool(tool_base_dir, 'dem_mosaic')
    want_err = '--errorimage' in args.point2dem_options
    want_ortho = '--orthoimage' in args.point2dem_options

    pres = [os.path.join(pair_dir(args.out_prefix, li, ri), 'run')
            for (li, ri, _, _) in pairs]
    pres = [p for p in pres if os.path.exists(p + '-DEM.tif')]
    if len(pres) == 0:
        raise Exception("No per-pair DEMs were produced.")

    # Blunder filter against the seed DEM --dem, if given.
    if args.seed_dem != "":
        pres = blunder_filter(pres, args.seed_dem, args.blunder_tol)
    if len(pres) == 0:
        raise Exception("No per-pair DEM survived the blunder filter against the seed "
                        "DEM (--dem). Every pair's DEM departs from it by more than "
                        "--blunder-tol (" + str(args.blunder_tol) + " m). This usually "
                        "means bad cameras or a large triangulation error, not a tool "
                        "issue. Inspect the per-pair run-IntersectionErr.tif.")

    mos = args.out_prefix
    mosaic_opts = shlex.split(args.dem_mosaic_options.replace('\\', ' '))
    # The per-pair products already share one grid (point2dem ran with the same --tr
    # and --t_srs), so dem_mosaic needs no grid options. The DEM is blended. The error
    # is combined with --max, the worst-case ray self-consistency over the overlapping
    # pairs. The orthoimage is combined with --first, taking the first valid pixel to
    # avoid smearing seams from blending.
    cmds = [shlex.join([dm] + mosaic_opts + [p + '-DEM.tif' for p in pres] +
                       ['-o', mos + '-DEM.tif'])]
    outputs = [mos + '-DEM.tif']
    if want_err:
        errs = [p + '-IntersectionErr.tif' for p in pres]
        cmds.append(shlex.join([dm, '--max'] + errs +
                               ['-o', mos + '-IntersectionErr.tif']))
        outputs.append(mos + '-IntersectionErr.tif')
    if want_ortho:
        cmds.append(shlex.join([dm, '--first'] + [p + '-DRG.tif' for p in pres] +
                               ['-o', mos + '-DRG.tif']))
        outputs.append(mos + '-DRG.tif')

    run_parallel(cmds, min(len(cmds), args.processes))
    for o in outputs:
        print("Wrote: " + o)

def conv_angle_pairs(args):
    """Image-name pairs whose median convergence angle is within --conv-angle-range,
    from the bundle_adjust report given by --conv-angle-list. Cameras are
    resolved separately, from --image-list and --camera-list."""
    vals = args.conv_angle_range.split(',')
    if len(vals) != 2:
        raise Exception("--conv-angle-range must be two comma-separated values, no "
                        "quotes, for example 15,45.")
    lo = float(vals[0])
    hi = float(vals[1])
    if lo >= hi:
        raise Exception("--conv-angle-range needs min < max, for example 15,45.")

    report = args.conv_angle_list
    if not os.path.exists(report):
        raise Exception("Cannot find the convergence angle report: " + report +
                        ". It is written by bundle_adjust.")

    # Columns: left_image right_image 25% 50% 75% num_matches. Select on the median.
    pairs = []
    total = 0
    with open(report, 'r') as f:
        for line in f:
            line = line.strip()
            if line == "" or line.startswith('#'):
                continue
            toks = line.split()
            if len(toks) < 5:
                continue
            total += 1
            med = float(toks[3])
            if lo <= med <= hi:
                pairs.append((toks[0], toks[1]))

    print("Convergence angle range [" + str(lo) + ", " + str(hi) + "] deg: kept " +
          str(len(pairs)) + " of " + str(total) + " pair(s) from " + report + ".")
    if len(pairs) == 0:
        raise Exception("No image pairs fall within --conv-angle-range.")
    return pairs

def run_dem_mosaic(args, tool_base_dir):
    """Drive mode 'dem_mosaic': stereo, then per-pair DEM, then mosaic."""
    step_dict = STEP_DICTS["dem_mosaic"]
    first = step_dict[args.first_step]
    last = step_dict[args.last_step]
    resolver = build_image_resolver(args.image_list, args.camera_list,
                                    args.seed_dem, tool_base_dir)
    if args.overlap_list != "":
        name_pairs = read_overlap_pairs(args.overlap_list, 2)
    else:
        name_pairs = conv_angle_pairs(args)
    pairs = []
    for (left, right) in name_pairs:
        (li, lc) = resolve_image(resolver, left)
        (ri, rc) = resolve_image(resolver, right)
        pairs.append((li, ri, lc, rc))
    print("Mode 'dem_mosaic': " + str(len(pairs)) + " pair(s).")
    if first <= 0 and last >= 0:
        pairs = run_pooled_stereo(args, pairs, tool_base_dir)
    # The DEM and fuse steps must run only on pairs that actually produced a point
    # cloud. A pair can be dropped in stereo (too few interest points, textureless
    # water) with no run-PC.tif. Filtering by what is on disk also makes each step
    # correct when started on its own (--first-step dem or fuse).
    if first <= 1 and last >= 1:
        pairs = keep_pairs(pairs, args, '-PC.tif')
        if len(pairs) == 0:
            raise Exception("No pair produced a point cloud (run-PC.tif), so no DEM "
                            "can be made. Check the per-pair stereo logs under "
                            + args.out_prefix + "-pairs.")
        dem_stage_dem(args, pairs, tool_base_dir)
    if first <= 2 and last >= 2:
        pairs = keep_pairs(pairs, args, '-DEM.tif')
        if len(pairs) == 0:
            raise Exception("No pair produced a DEM (run-DEM.tif), so there is nothing "
                            "to mosaic. Check the per-pair stereo logs under "
                            + args.out_prefix + "-pairs.")
        dem_stage_fuse(args, pairs, tool_base_dir)

if __name__ == "__main__":

    args = process_args(sys.argv)
    sanity_checks(args)

    # If --nodes-list is given, use it as the node file for the pooled jobs. The
    # pooling in run_parallel reads $PBS_NODEFILE, so set it here.
    if args.nodes_list != "":
        os.environ['PBS_NODEFILE'] = args.nodes_list

    out_parent = os.path.dirname(args.out_prefix)
    if out_parent != "":
        asp_rig_utils.mkdir_p(out_parent)

    tool_base_dir = os.path.dirname(os.path.dirname(os.path.abspath(sys.argv[0])))

    # Mode 'dem_mosaic' has its own driver. It needs no rig or undistortion.
    if args.mode == "dem_mosaic":
        run_dem_mosaic(args, tool_base_dir)
        sys.exit(0)

    # Mode 'mesh' below.
    step_dict = STEP_DICTS["mesh"]
    sensors = args.rig_sensor.split()

    # The shared asp_rig_utils.undistort_images() helper writes under args.out_dir, but
    # this tool uses --output-prefix. Give the helper a derived undistortion directory.
    args.out_dir = args.out_prefix + "-undist"

    # Read the images and camera poses
    # TODO(oalexan1): Make the block below a function
    all_distorted_images = []
    all_undistorted_images = []
    all_cams = []
    all_cam_to_world_files = []
    for sensor in sensors:

        (distorted_images, world_to_cam) \
                             = asp_rig_utils.parse_cameras(args.camera_poses,
                                                       "",
                                                       sensor,
                                                       None,
                                                       None)

        # Write undistorted images
        extension = '.tif' # use lossless .tif extension for undistorted images
        extra_opts = []
        suff = ""
        (undist_intrinsics_file, undistorted_images, undist_dir) \
                                 = asp_rig_utils.undistort_images(args, sensor,
                                                              distorted_images,
                                                              tool_base_dir,
                                                              extension, extra_opts, suff)
        # Write camera poses in the format of ASP and voxblox
        (undistorted_images, cameras, cam_to_world_files) \
                             = write_asp_and_voxblox_cameras(undist_intrinsics_file,
                                                             distorted_images,
                                                             undistorted_images,
                                                             world_to_cam)
        all_distorted_images += distorted_images
        all_undistorted_images += undistorted_images
        all_cams += cameras
        all_cam_to_world_files += cam_to_world_files

    first = step_dict[args.first_step]
    last  = step_dict[args.last_step]

    # Build the pairs as (left_image, right_image, left_camera, right_camera), from the
    # undistorted images and the cameras written above. The stereo step is shared with
    # mode 'dem_mosaic' (run_pooled_stereo), so it is load balanced across all pairs.
    index_pairs = gen_pairs(args, all_distorted_images)
    mesh_pairs = [(all_undistorted_images[L], all_undistorted_images[R],
                   all_cams[L], all_cams[R]) for (L, R) in index_pairs]

    if first <= 0 and last >= 0:
        run_pooled_stereo(args, mesh_pairs, tool_base_dir)

    # Then filter each pair's cloud and write a .pcd for voxblox.
    pcd_files = []
    for pair in mesh_pairs:
        pcd = os.path.join(pair_dir(args.out_prefix, pair[0], pair[1]),
                           'run-PC-filter.pcd')
        if first <= 1 and last >= 1:
            pcd = mesh_pc_filter(args, pair, tool_base_dir)
        pcd_files.append(pcd)

    if first <= 2 and last >= 2:
        fuse_clouds(args, index_pairs, all_cam_to_world_files, pcd_files, tool_base_dir)
