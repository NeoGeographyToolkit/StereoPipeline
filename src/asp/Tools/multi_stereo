                        "pc_filter, then a fused voxblox mesh, with rig cameras) or " + \
                        "'dem_mosaic' (pairwise stereo on mapprojected images with "  + \
                        "the given cameras and a seed DEM, per-pair point2dem, then " + \
                        "a DEM mosaic and a maximum triangulation error mosaic). "    + \
                        "Required.")

    parser.add_argument("--overlap-list", dest="overlap_list", default="",
                        help = "Text file with the image pairs to run stereo on, one " + \
                        "pair per line. For mode 'mesh': two columns, "                + \
                        "'left_image right_image', with names as in --camera_poses. "  + \
                        "For mode 'dem_mosaic': four columns, "                        + \
                        "'left_image right_image left_camera right_camera'. Lines "    + \
                        "starting with '#' and blank lines are ignored. Required.")

    parser.add_argument("--out_dir", dest="out_dir",
